@page "/autocomplete"
@inject QueryClient Client

<PageTitle>Autocomplete</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Autocomplete</MudText>

<MudText Class="mb-4">
    <MudChip T="string" Size="Size.Small">MudAutocomplete</MudChip> asks for a search function,
    not for a component that re-renders when data arrives, so
    <MudChip T="string" Size="Size.Small">Q.Query</MudChip> is the wrong tool here.
    <MudChip T="string" Size="Size.Small">QueryAsync</MudChip> is the whole answer: it hands
    back data the registry already holds when that data is still fresh, and only reaches the
    handler when it is not. Staleness belongs to the query, so this page does not own a copy
    of it.
</MudText>

<MudAutocomplete T="Product"
                 Label="Search products"
                 SearchFunc="Search"
                 ToStringFunc="@(p => p?.Name ?? string.Empty)"
                 ResetValueOnEmptyText="true"
                 CoerceText="true"
                 Class="mb-4" />

<MudText Typo="Typo.h6" GutterBottom="true">Requests the service actually received</MudText>

<MudPaper Outlined="true" Class="pa-4">
    @if (CatalogService.SearchRequests.Count == 0)
    {
        <MudText Typo="Typo.body2">Nothing yet. Type above.</MudText>
    }
    else
    {
        <MudList T="string" Dense="true">
            @foreach (var entry in CatalogService.SearchRequests)
            {
                <MudListItem>@entry</MudListItem>
            }
        </MudList>
    }
</MudPaper>

<MudText Typo="Typo.caption" Class="mt-2">
    Delete back to a term you have already typed. The list above does not grow, because the
    term is still fresh and <MudChip T="string" Size="Size.Small">QueryAsync</MudChip> answers
    from the registry without calling the service.
</MudText>

@code {
    private async Task<IEnumerable<Product>> Search(string term, CancellationToken ct)
    {
        term ??= string.Empty;

        var results = await Client.QueryAsync(
            QueryOptions
                .Create<(string, string), List<Product>>(
                    ("product-search", term),
                    async static ctx => await CatalogService.SearchAsync(
                        ctx.Key.Item2, ctx.CancellationToken ?? default))
                .ConfigureFetch(f => f.StaleTime(TimeSpan.FromMinutes(5)))
                // Longer than the stale time, deliberately. Nothing subscribes to a query made
                // this way, so it goes on the eviction list the moment its fetch settles. With
                // the default GcTime of five minutes it would be collected exactly when its own
                // freshness window ran out, and could never serve a hit.
                .ConfigureCache(c => c.GcTime(TimeSpan.FromMinutes(30)))
                .Build(),
            // MudBlazor cancels a search the moment the next keystroke supersedes it. The token
            // abandons this await, not the fetch: the request already on the wire runs on and
            // its result still lands in the registry, ready for the backspace that follows.
            ct);

        // MudAutocomplete awaits this from its own component, so nothing here repaints the page
        // unless the page asks for it.
        await InvokeAsync(StateHasChanged);

        return results;
    }
}
