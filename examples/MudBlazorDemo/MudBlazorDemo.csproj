<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- An example, never a package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <!--
    Project references, not packages, so every build of the examples is a smoke test of the
    working tree rather than of whatever version was last published.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\RevalQuery.Core\RevalQuery.Core.csproj" />
    <ProjectReference Include="..\..\RevalQuery.Blazor\RevalQuery.Blazor.csproj" />
  </ItemGroup>

</Project>
