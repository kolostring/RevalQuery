@page "/search-bar-reval-query"
@using CachingDemo.Client.Services
@using RevalQuery.Core
@using RevalQuery.Core.Abstractions.Query
@using RevalQuery.Core.Query.Options
@rendermode InteractiveWebAssembly
@inherits RevalQuery.Blazor.QueryComponentBase

<PageTitle>Search Bar Example</PageTitle>

<div class="search-box">
    <div style="display: flex; gap: 8px;">
        <input @bind="SearchTerm" @bind:event="oninput" placeholder="Type to search..." />

        @if (Suggestions.IsFetching)
        {
            <div>
                Loading...
            </div>
        }
    </div>

    @if (Suggestions.Exception is not null)
    {
        <p style="color:red">Error: @Suggestions.Exception.Message</p>
    }
    else if (Suggestions.Data is not null)
    {
        <ul>
            @foreach (var item in Suggestions.Data)
            {
                <li>@item</li>
            }
        </ul>
    }
    else if (!Suggestions.IsFetching)
    {
        <p><em>Nothing to show</em></p>
    }
</div>

@code {
    private string SearchTerm { get; set; } = string.Empty;

    /// <summary>
    /// Fills the cache during the prerender only, so the browser has the first result set the
    /// moment it becomes interactive instead of waiting a second for its own request.
    /// </summary>
    /// <remarks>
    /// Guarded on IsInteractive because this method runs twice, once on the server and once in
    /// the browser. Fetching in both would do the work the transfer exists to avoid.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive) return;

        try
        {
            await Client.FetchQueryAsync(SuggestionsFor(string.Empty));
        }
        catch
        {
            // SearchAsync fails one time in ten on purpose. A prerender that cannot fill the
            // cache is not a broken page: the browser fetches for itself.
        }
    }

    private static QueryOptions<(string, string), List<string>> SuggestionsFor(string term) =>
        QueryOptions
            .Create<(string, string), List<string>>(
                ("search", term),
                async static ctx => await SearchService.SearchAsync(ctx.Key.Item2, ctx.CancellationToken))
            .ConfigureFetch(fetch => fetch.StaleTime(TimeSpan.FromMinutes(5)))
            .Build();

    // Passing the token through is what lets Cancel, and a key change, actually stop a fetch.
    // Dropping it leaves the request running and its result arriving anyway.
    IQueryState<List<string>> Suggestions => UseQuery(SuggestionsFor(SearchTerm));
}