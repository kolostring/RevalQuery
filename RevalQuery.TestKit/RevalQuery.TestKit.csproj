<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Every framework the test projects run on, since both of them reference this kit. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RevalQuery.TestKit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevalQuery.Core\RevalQuery.Core.csproj" />
  </ItemGroup>

</Project>
