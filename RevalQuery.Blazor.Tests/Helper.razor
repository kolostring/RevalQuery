@inject Fx Fx
@inject RevalHooks Reval
<RevalRenderer Component="this" Hooks="Reval" />
<span class="item">@Detail(1)</span>
<span class="item">@Detail(2)</span>
<span class="item">@Reval.Query(Fx.Detail(3)).Data@Reval.Query(Fx.Detail(4)).Data</span>
@code {
    [Parameter] public int Tick { get; set; }
    string? Detail(int id) => Reval.Query(Fx.Detail(id)).Data;
}
