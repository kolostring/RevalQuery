@inject Fx Fx
@inject QueryClient Client
<QueryHost Scope="Q" />
<p id="out">@(Item.IsLoading ? "loading" : Item.Data)</p>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Tick { get; set; }
    public int Renders;
    IQueryState<string> Item => Q.Query(Fx.Detail(Id));
    protected override void OnAfterRender(bool firstRender) => Renders++;
    QueryScope? _q;
    public QueryScope Q => _q ??= Client.CreateScope(this);
}
