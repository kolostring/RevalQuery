@inject Fx Fx
@inject RevalHooks Reval
<RevalRenderer Component="this" Hooks="Reval" />
<p id="out">@(Item.IsLoading ? "loading" : Item.Data)</p>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Tick { get; set; }
    public int Renders;
    IQueryState<string> Item => Reval.Query(Fx.Detail(Id));
    protected override void OnAfterRender(bool firstRender) => Renders++;
}
