@inject Fx Fx
@inject RevalClient Client
<RevalRenderer Component="this" Hooks="_hooks" />
<p id="out">@_hooks.Query(Fx.Detail(Id)).Data</p>
@code {
    [Parameter] public int Id { get; set; }
    RevalHooks _hooks = default!;
    int _hooksId = -1;
    protected override void OnParametersSet()
    {
        if (_hooksId == Id) return;
        _hooksId = Id;
        _hooks = Client.CreateHooks();
    }
}
