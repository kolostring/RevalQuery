@inject Fx Fx
@inject QueryClient Client
<QueryRenderer Component="this" Tracker="_tracker" />
<p id="out">@_tracker.Query(Fx.Detail(Id)).Data</p>
@code {
    [Parameter] public int Id { get; set; }
    QueryTracker _tracker = default!;
    int _trackerId = -1;
    protected override void OnParametersSet()
    {
        if (_trackerId == Id) return;
        _trackerId = Id;
        _tracker = Client.CreateTracker();
    }
}
