@inject Fx Fx
@inject RevalHooks Reval
<RevalRenderer Component="this" Hooks="Reval" />
<p id="own">@(_seen?.Data ?? "none")</p>
<Popover>
    @{ _seen = Reval.Query(Fx.Detail(1)); }
    <span class="item">@_seen.Data</span>
</Popover>
@code {
    IQueryState<string>? _seen;
    public int Renders;
    protected override void OnAfterRender(bool firstRender) => Renders++;
}
