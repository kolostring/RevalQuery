<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Every framework the library targets, so none of them ships only compiled. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>RevalQuery.Blazor.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="1.40.0" />
    <!-- bunit 1.40.0 brings 1.2.0, which carries an advisory. A test-only HTML parser, so the newer one is safe to float. -->
    <PackageReference Include="AngleSharp" Version="1.8.3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="RevalQuery.TestKit" />
    <Using Include="RevalQuery.TestKit.Kit" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevalQuery.Core\RevalQuery.Core.csproj" />
    <ProjectReference Include="..\RevalQuery.Blazor\RevalQuery.Blazor.csproj" />
    <ProjectReference Include="..\RevalQuery.TestKit\RevalQuery.TestKit.csproj" />
  </ItemGroup>

</Project>
