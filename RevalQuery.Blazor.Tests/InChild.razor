@inject Fx Fx
@inject QueryTracker Q
<QueryRenderer Component="this" Tracker="Q" />
<p class="own">@Q.Query(Fx.Detail(0)).Data</p>
@if (Kind == "popover")
{
    <Popover>
        @foreach (var id in Ids)
        {
            <span class="item">@Q.Query(Fx.Detail(id)).Data</span>
        }
    </Popover>
}
else
{
    <Gated Gate="Gate">
        @foreach (var id in Ids)
        {
            <span class="item">@Q.Query(Fx.Detail(id)).Data</span>
        }
    </Gated>
}
@code {
    [Parameter] public string Kind { get; set; } = "popover";
    [Parameter] public List<int> Ids { get; set; } = [];
    [Parameter] public Task Gate { get; set; } = Task.CompletedTask;
    [Parameter] public int Tick { get; set; }
}
