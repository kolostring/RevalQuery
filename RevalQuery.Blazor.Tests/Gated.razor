@if (_ready)
{
    @ChildContent
}
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Task Gate { get; set; } = Task.CompletedTask;
    bool _ready;
    protected override async Task OnParametersSetAsync()
    {
        _ready = false;
        await Gate;
        _ready = true;
    }
}
