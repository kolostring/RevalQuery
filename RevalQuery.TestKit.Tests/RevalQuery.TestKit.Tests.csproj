<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Every framework the kit targets, so none of them is only compiled. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="RevalQuery.TestKit" />
    <Using Include="RevalQuery.TestKit.Kit" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevalQuery.Core\RevalQuery.Core.csproj" />
    <ProjectReference Include="..\RevalQuery.TestKit\RevalQuery.TestKit.csproj" />
  </ItemGroup>

</Project>
